POLARIS_DATABASE_URL=postgres://polaris:polaris@localhost:5432/polaris?sslmode=disable
POLARIS_HTTP_ADDRESS=:8080
POLARIS_WORKER_INTERVAL_SECONDS=10
POLARIS_PROMETHEUS_MAX_RESPONSE_BYTES=4194304

# OpenID Connect (Google). Create a Web application OAuth client at
# https://console.cloud.google.com/apis/credentials; the same client ID must be
# configured here and in the control tower build (VITE_GOOGLE_CLIENT_ID).
POLARIS_OIDC_ISSUER=https://accounts.google.com
POLARIS_OIDC_CLIENT_ID=

# Shared secret required by POST /fitness-functions/{id}/measurement-submissions
# and POST /measurement-submission-batches (X-API-Key header).
POLARIS_INGEST_SECRET_KEY=

# Control tower (web) build-time configuration.
VITE_GOOGLE_CLIENT_ID=
