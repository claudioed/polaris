POLARIS_DATABASE_URL=postgres://polaris:polaris@localhost:5432/polaris?sslmode=disable
POLARIS_HTTP_ADDRESS=:8080
POLARIS_WORKER_INTERVAL_SECONDS=10
POLARIS_PROMETHEUS_MAX_RESPONSE_BYTES=4194304

# Host ports published by Docker Compose, bound to loopback only so nothing is
# reachable beyond the host. Change these if a port is already in use.
POLARIS_POSTGRES_PORT=5432
POLARIS_HTTP_PORT=8080
POLARIS_CONTROL_TOWER_PORT=3000

# Public domain served by the Caddy edge (docker compose --profile edge up).
# DNS for the domain must point at this host; Caddy obtains and renews a Let's
# Encrypt certificate automatically. Add https://<domain> as an authorized
# JavaScript origin on the Google OAuth client; the client ID is unchanged.
POLARIS_DOMAIN=polaris-harness.cloud
POLARIS_EDGE_HTTP_PORT=80
POLARIS_EDGE_HTTPS_PORT=443

# OpenID Connect (Google). Create a Web application OAuth client at
# https://console.cloud.google.com/apis/credentials; the same client ID must be
# configured here and in the control tower build (VITE_GOOGLE_CLIENT_ID).
POLARIS_OIDC_ISSUER=https://accounts.google.com
POLARIS_OIDC_CLIENT_ID=
# The only verified Google account allowed to use business endpoints.
POLARIS_AUTHORIZED_EMAIL=claudioed.oliveira@gmail.com

# Shared secret required by POST /fitness-functions/{id}/measurement-submissions
# and POST /measurement-submission-batches (X-API-Key header).
POLARIS_INGEST_SECRET_KEY=

# Control tower (web) build-time configuration.
VITE_GOOGLE_CLIENT_ID=
